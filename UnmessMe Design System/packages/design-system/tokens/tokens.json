      "text_legibility": { "$value": "0 2px 4px rgba(0,0,0,0.3)", "$type": "shadow" },
      "subtle": { "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.5)", "$type": "shadow" },
      "medium": { "$value": "0 4px 20px rgba(0, 0, 0, 0.4)", "$type": "shadow" },
      "heavy": { "$value": "0 12px 40px rgba(0,0,0,0.6)", "$type": "shadow" },
      "glow_seafoam": { "$value": "0 0 15px rgba(42, 157, 143, 0.4)", "$type": "shadow" },
      "focus_ring": { "$value": "0 0 0 2px rgba(42, 157, 143, 0.2)", "$type": "shadow" }
