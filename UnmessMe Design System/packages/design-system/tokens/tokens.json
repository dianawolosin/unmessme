          "sm": { "$value": "400px", "$type": "dimension", "$description": "Small container" },
          "md": { "$value": "600px", "$type": "dimension", "$description": "Medium container" },
          "lg": { "$value": "800px", "$type": "dimension", "$description": "Large container" },
          "xl": { "$value": "900px", "$type": "dimension", "$description": "Extra large container" }
        },
        "height": {
          "xs": { "$value": "20px", "$type": "dimension" },
          "sm": { "$value": "24px", "$type": "dimension" },
          "md": { "$value": "32px", "$type": "dimension" },
          "lg": { "$value": "48px", "$type": "dimension" },
          "xl": { "$value": "56px", "$type": "dimension" }
        }
      },
      "pattern": {
        "receipt_notch": { "$value": "8px 16px", "$type": "dimension" }
      },
      "transform": {
        "hover_lift": { "$value": "-4px", "$type": "dimension" },
        "hover_nudge": { "$value": "4px", "$type": "dimension" }
