        "font": { "$value": "{typography.primitive.fontFamily.serif}", "$type": "fontFamily" },
        "size": { "$value": "{typography.primitive.fontSize.3xl}", "$type": "dimension" },
        "weight": { "$value": "{typography.primitive.fontWeight.bold}", "$type": "fontWeight" },
        "lineHeight": { "$value": 1.15, "$type": "number" },
        "letterSpacing": { "$value": "-0.02em", "$type": "dimension" }
      },
      "h3": {
        "font": { "$value": "{typography.primitive.fontFamily.serif}", "$type": "fontFamily" },
