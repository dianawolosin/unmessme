    "semantic": {
      "text": {
        "legibility": { "$value": "{elevation.primitive.text_legibility}", "$type": "shadow" }
      },
      "card": {
        "rest": { "$value": "{elevation.primitive.medium}", "$type": "shadow" },
        "focused": { "$value": "{elevation.primitive.heavy}", "$type": "shadow", "$description": "Active state for ProblemCard" },
        "hover": { "$value": "none", "$type": "shadow", "$description": "Flat on hover" }
      },
      "button": {
        "primary": { "$value": "none", "$type": "shadow", "$description": "Flat buttons" },
        "hover": { "$value": "none", "$type": "shadow" }
      },
      "modal": { "$value": "0 20px 50px -10px rgba(0,0,0,0.7)", "$type": "shadow" },
      "focus_ring": { "$value": "{elevation.primitive.focus_ring}", "$type": "shadow" }
    }
