      },
      "button": {
        "font": { "$value": "{typography.primitive.fontFamily.mono}", "$type": "fontFamily" },
        "size": { "$value": "{typography.primitive.fontSize.sm}", "$type": "dimension" },
        "weight": { "$value": "{typography.primitive.fontWeight.bold}", "$type": "fontWeight" },
        "lineHeight": { "$value": 1.5, "$type": "number" },
        "letterSpacing": { "$value": "0.02em", "$type": "dimension" }
      },
      "caption": {
        "font": { "$value": "{typography.primitive.fontFamily.mono}", "$type": "fontFamily" },
        "size": { "$value": "{typography.primitive.fontSize.xs}", "$type": "dimension" },
        "weight": { "$value": "{typography.primitive.fontWeight.regular}", "$type": "fontWeight" },
        "lineHeight": { "$value": 1.4, "$type": "number" },
        "letterSpacing": { "$value": "0", "$type": "dimension" }
      },
      "overline": {
        "font": { "$value": "{typography.primitive.fontFamily.mono}", "$type": "fontFamily" },
